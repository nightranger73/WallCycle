procedure LoadEmbeddedAppIcon(TargetIcon: TIcon);
var
  MS: TMemoryStream;
  Png: TPortableNetworkGraphic;
  Bmp: TBitmap;
  IL: TImageList;
begin
  if TargetIcon = nil then Exit;
  MS := TMemoryStream.Create;
  Png := TPortableNetworkGraphic.Create;
  Bmp := TBitmap.Create;
  try
    MS.WriteBuffer(EMBED_WALLCYCLE_PNG_48[0], Length(EMBED_WALLCYCLE_PNG_48));
    MS.Position := 0;
    Png.LoadFromStream(MS);
    if (Png.Width > 0) and (Png.Height > 0) then
    begin
      Bmp.Assign(Png);
      IL := TImageList.CreateSize(Bmp.Width, Bmp.Height);
      try
        IL.Add(Bmp, nil);
        IL.GetIcon(0, TargetIcon);
      finally
        IL.Free;
      end;
    end;
  finally
    Bmp.Free;
    Png.Free;
    MS.Free;
  end;
end;

